CONFIG_IDF_TARGET="esp32"

# The AI-Thinker ESP32-CAM has 4 MB of flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Most ESP32-CAM boards carry PSRAM; keep booting even if this one does not.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# The default 5.7 kB TCP window caps throughput for large (uncompressed) frames.
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384

# The viewer (ESP32-C5) opens the access point; these must match its
# CONFIG_APP_AP_SSID / CONFIG_APP_AP_PASSWORD.
CONFIG_APP_WIFI_MODE_STA=y
CONFIG_APP_WIFI_STA_SSID="ESP32-C5-CAM"
CONFIG_APP_WIFI_STA_PASSWORD="c5cam12345"
